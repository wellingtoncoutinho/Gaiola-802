{
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/trash-reminder",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/cleaning-reminder",
      "schedule": "0 13 * * 5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/reservations/:path*",
      "destination": "/api/reservations"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
